{
  // The web ads and their runtime run in a browser, not the engine (ADR 0069).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // `playable new` points this at the engine it runs from.
    "paths": { "@gameengine/playable/*": ["../../../../Users/Johanna Regirozzi/AppData/Local/Programs/Tactile Game Engine/resources/engine/packages/playable/src/*.ts"] }
  },
  "include": ["_shared", "*/web"]
}
