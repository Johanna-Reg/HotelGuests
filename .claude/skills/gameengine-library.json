  "settings": "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"if command -v gameengine >/dev/null 2>&1; then gameengine skills update --auto || true; elif [ -f \\\"$CLAUDE_PROJECT_DIR/.gameengine/engine/tools/cli/bin/gameengine.mjs\\\" ]; then node \\\"$CLAUDE_PROJECT_DIR/.gameengine/engine/tools/cli/bin/gameengine.mjs\\\" skills update --auto || true; echo 'note: gameengine is not on PATH (skills were updated through .gameengine/engine); fix: node .gameengine/engine/tools/cli/bin/gameengine.mjs setup --path'; else echo 'warning: gameengine is not on PATH (skills not updated, gameengine commands will fail); fix: in the engine checkout run: node tools/cli/bin/gameengine.mjs setup --path'; fi\",\n            \"timeout\": 60\n          }\n        ]\n      }\n    ]\n  }\n}\n",
  "codex": "# Installed by `gameengine skills update` (the engine's templates/_shared), which merges it table by\n# table: your own keys and tables stay. Codex reads it once the project is trusted. `.gameengine/engine` links to the engine checkout (`gameengine new` and\n# `skills update` make it), so this works without `gameengine` on PATH, and `node` is a real\n# executable on every OS (a `gameengine.cmd` launcher is not spawnable without a shell on Windows).\n[mcp_servers.gameengine]\ncommand = \"node\"\nargs = [\".gameengine/engine/tools/cli/bin/gameengine.mjs\", \"mcp\"]\n# `test`, `check` and cooks run up to the server's own 10-minute limit (LONG_TIMEOUT_MS in\n# tools/cli/src/mcp.ts), which stops their hosts and reports; Codex's 60 s default would cut them off first.\ntool_timeout_sec = 660\n",
